# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored: never commit a real key.

# PostgreSQL connection string (matches docker-compose.yml defaults).
# Render hands out postgres://… or postgresql://…; both are accepted and rewritten
# to the psycopg 3 driver on load.
DATABASE_URL=postgresql+psycopg://axiom:axiom@localhost:5432/axiom

# Comma-separated browser origins allowed to call this API. No wildcard and no
# trailing slash. Unset means the two local dev origins.
CORS_ORIGINS=https://your-frontend.vercel.app

# LLM provider for the pipeline. Only "openai" is implemented.
LLM_PROVIDER=openai
# Placeholder only.
LLM_API_KEY=your_key_here
LLM_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# Single local account for the app's sign-in (Phase 8).
# Generate the hash with: python scripts/make_password_hash.py
# AXIOM_SECRET is any long random string; changing it signs everyone out.
AXIOM_USERNAME=your_username_here
AXIOM_PASSWORD_HASH=pbkdf2_sha256$200000$your_salt_hex$your_hash_hex
AXIOM_SECRET=your_long_random_secret_here
AXIOM_TOKEN_HOURS=12
